# EFNS Prototype v0.1 — Environment Configuration
# ===============================================
# Copy to .env and fill in values.
# Do NOT commit .env to version control.

# Snowflake connection (optional for local/mock mode).
# Preferred: a named connector connection, SSO, or key-pair authentication.
SNOWFLAKE_CONNECTION_NAME=
SNOWFLAKE_STREAMLIT_CONNECTION=snowflake
SNOWFLAKE_ACCOUNT=your_account_here
SNOWFLAKE_USER=your_user_here
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# Optional development-only password. Leave blank for SSO or key-pair auth.
SNOWFLAKE_PASSWORD=
# Optional key-pair files must remain outside the repository.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=
SNOWFLAKE_WAREHOUSE=EFNS_DEV_WH
SNOWFLAKE_DATABASE=EFNS_DEV
SNOWFLAKE_SCHEMA_RAW=RAW
SNOWFLAKE_SCHEMA_CORE=CORE
SNOWFLAKE_SCHEMA_REPORTING=REPORTING
SNOWFLAKE_ROLE=EFNS_DEV_ROLE

# Repository mode: "mock" or "snowflake"
REPOSITORY_MODE=mock

# App settings
APP_TITLE=EFNS Internal Data System
APP_VERSION=0.2.0

# Synthetic data seed for reproducibility
SYNTHETIC_DATA_SEED=42
